{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nobrainer": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/nobrainer",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "assets": [
              {
                "glob": "NoBrainer_GitHub_v0.12.2.runtime.js",
                "input": ".generated",
                "output": "/legacy/"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/save-transfer-v0.17.3.css",
              "src/ui-shell-v0.12.0.css",
              "src/character-selection-v0.16.0.css",
              "src/forge-compact-v0.15.4.css",
              "src/dungeon-modal-v0.15.0.css",
              "src/weapon-images-v0.17.0.css"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "/pj-nobrainer/",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "baseHref": "/",
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nobrainer:build:production"
            },
            "development": {
              "buildTarget": "nobrainer:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
